<views:BaseView x:Class="Hud_Principal.Views.VigidesastresSecasView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:Hud_Principal.Views"
                Background="#0d0f0e">

    <DockPanel>

        <Button DockPanel.Dock="Top"
                Content="← Voltar"
                HorizontalAlignment="Left"
                Style="{StaticResource SidebarButton}"
                FontSize="13"
                Padding="10,6"
                Margin="20,16,0,0"
                Click="BtnHome_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,24,48,40">

                <!-- Cabeçalho -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Vigidesastres — Vigilância em Saúde Relacionada aos Riscos de Desastres"
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="Monitor de Secas"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Shapefiles mensais · Monitor de Secas / ANA"
                               FontSize="14" Foreground="#999999"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Logotipo -->
                <Image Width="180" Height="180"
                       Margin="0,0,0,24"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Assets/Vigidesastres_Logo.png"/>

                <!-- Descrição -->
                <TextBlock TextWrapping="Wrap"
                           Foreground="#cccccc"
                           FontSize="13"
                           Margin="0,0,0,8">
                    Baixa os mapas mensais do Monitor de Secas (ANA) em formato shapefile para a
                    pasta de arquivos brutos e, em seguida, cruza os mapas com a malha municipal de
                    Rondônia, gravando SECAS_MESTRE.xlsx na pasta do mestre (% da área de cada
                    município por categoria, categoria máxima e predominante) para o Power BI.
                </TextBlock>

                <TextBlock TextWrapping="Wrap"
                           Foreground="#666666"
                           FontSize="12"
                           Margin="0,0,0,32">
                    Meses já baixados e já gravados são pulados. Meses ainda não publicados pela ANA
                    ficam para uma próxima execução. O processamento só considera a partir de
                    agosto/2022, quando o mapa passou a cobrir Rondônia.
                </TextBlock>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Seleção de anos -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Anos" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock Text="Clique para selecionar um ou mais anos."
                               FontSize="11" Foreground="#555555" Margin="0,0,0,8"/>
                    <ListBox x:Name="ListBoxAnos"
                             SelectionMode="Multiple"
                             Height="120"
                             Background="#1a1a1a"
                             Foreground="#e5e7e6"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             FontSize="13"
                             Width="200"
                             HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Ação -->
                <Button x:Name="BtnRun"
                        Content="Coletar e Processar"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SidebarButton}"
                        Padding="16,8"
                        Margin="0,0,0,16"
                        Click="BtnRun_Click"/>

                <!-- Resumo -->
                <TextBlock x:Name="TxtSummary"
                           TextWrapping="Wrap"
                           Foreground="#1D9E75"
                           FontSize="13"
                           Margin="0,0,0,8"/>

                <!-- Log de status -->
                <Border Background="#111111"
                        BorderBrush="#2e2e2e"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        MinHeight="60">
                    <ScrollViewer x:Name="StatusScroll"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtStatus"
                                   Foreground="#9CA3A0"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</views:BaseView>
